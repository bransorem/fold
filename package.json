{
  "name": "fold",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "imports": {
    "#/*": "./client/*"
  },
  "scripts": {
    "dev": "turbo run //#dev:web api:dev",
    "dev:web": "vite dev --port 3000",
    "dev:server": "turbo run api:dev --filter=@fold/api",
    "generate-routes": "tsr generate",
    "build": "turbo run //#build:web build:api",
    "build:web": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome check",
    "type-check": "turbo run type-check",
    "test": "turbo test",
    "audit": "bun audit",
    "check": "biome check",
    "check:all": "bun audit && bun run lint && bun run type-check && bun test && bun run build",
    "deploy": "bun run build && wrangler deploy",
    "deploy:server": "turbo run deploy --filter=@fold/api",
    "tail:api": "bunx wrangler tail fold-api --config server/wrangler.jsonc",
    "tail:web": "bunx wrangler tail fold --config wrangler.jsonc",
    "db:migrate": "cd server && bun run db:migrate:local",
    "db:migrate:remote": "cd server && bun run db:migrate:remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "undici": "7.30.1"
  },
  "workspaces": [
    "server"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
